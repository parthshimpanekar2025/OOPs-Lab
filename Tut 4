#include <iostream>
using namespace std;

class Complex {
private:
    double real;
    double imag;

public:
   
    Complex() : real(0), imag(0) {}

   
    Complex(double r, double i) : real(r), imag(i) {}

  
    void readComplex() {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void displayComplex() const {
        if (imag >= 0)
            cout << real << " + " << imag << "i" << endl;
        else
            cout << real << " - " << (-imag) << "i" << endl;
    }

    
    Complex add(const Complex &c) const {
        return Complex(real + c.real, imag + c.imag);
    }

   
    Complex subtract(const Complex &c) const {
        return Complex(real - c.real, imag - c.imag);
    }

    
    Complex multiply(const Complex &c) const {
        double r = real * c.real - imag * c.imag;
        double i = real * c.imag + imag * c.real;
        return Complex(r, i);
    }

    Complex divide(const Complex &c) const {
        double denominator = c.real * c.real + c.imag * c.imag;

        if (denominator == 0) {
            cout << "Error: Division by zero complex number!" << endl;
            return Complex(0, 0);
        }

        double r = (real * c.real + imag * c.imag) / denominator;
        double i = (imag * c.real - real * c.imag) / denominator;
        return Complex(r, i);
    }

  
    Complex conjugate() const {
        return Complex(real, -imag);
    }
};

int main() {
    Complex c1, c2, result;
    int choice;

    do {
        cout << "\n----- Complex Number Operations -----\n";
        cout << "1. Add\n";
        cout << "2. Subtract\n";
        cout << "3. Multiply\n";
        cout << "4. Divide\n";
        cout << "5. Complex Conjugate\n";
        cout << "6. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "\nEnter first complex number:\n";
                c1.readComplex();
                cout << "Enter second complex number:\n";
                c2.readComplex();
                result = c1.add(c2);
                cout << "\nSum = ";
                result.displayComplex();
                break;

            case 2:
                cout << "\nEnter first complex number:\n";
                c1.readComplex();
                cout << "Enter second complex number:\n";
                c2.readComplex();
                result = c1.subtract(c2);
                cout << "\nDifference = ";
                result.displayComplex();
                break;

            case 3:
                cout << "\nEnter first complex number:\n";
                c1.readComplex();
                cout << "Enter second complex number:\n";
                c2.readComplex();
                result = c1.multiply(c2);
                cout << "\nProduct = ";
                result.displayComplex();
                break;

            case 4:
                cout << "\nEnter first complex number:\n";
                c1.readComplex();
                cout << "Enter second complex number:\n";
                c2.readComplex();
                result = c1.divide(c2);
                cout << "\nQuotient = ";
                result.displayComplex();
                break;

            case 5:
                cout << "\nEnter complex number:\n";
                c1.readComplex();
                result = c1.conjugate();
                cout << "\nConjugate = ";
                result.displayComplex();
                break;

            case 6:
                cout << "Exiting program...\n";
                break;

            default:
                cout << "Invalid choice! Please try again.\n";
        }

    } while (choice != 6);

    return 0;
}
