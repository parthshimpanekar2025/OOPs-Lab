#include <iostream>
using namespace std;

class Pascal
{
    int n;

public:
    void read()
    {
        cout << "Enter number of rows: ";
        cin >> n;
    }

    void display()
    {
        int value;

        for (int i = 0; i < n; i++)
        {
            value = 1;

            for (int space = 0; space < n - i - 1; space++)
                cout << " ";

            for (int j = 0; j <= i; j++)
            {
                cout << value << " ";

                value = value * (i - j) / (j + 1);
            }

            cout << endl;
        }
    }
};

int main()
{
    Pascal obj;

    obj.read();
    obj.display();

    return 0;
}
