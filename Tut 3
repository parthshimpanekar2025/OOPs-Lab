#include <iostream>
using namespace std;

class ArraySort
{
    int arr[100];
    int n;

public:
    // Function to read array
    void read()
    {
        cout << "Enter number of elements: ";
        cin >> n;

        cout << "Enter " << n << " elements: ";
        for (int i = 0; i < n; i++)
        {
            cin >> arr[i];
        }
    }

    // Function to display array
    void display()
    {
        for (int i = 0; i < n; i++)
        {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    // Function to swap two elements using call by reference
    void swap(int &a, int &b)
    {
        int temp = a;
        a = b;
        b = temp;
    }

    // Function to sort array
    void sortArray()
    {
        for (int i = 0; i < n - 1; i++)
        {
            for (int j = 0; j < n - i - 1; j++)
            {
                if (arr[j] > arr[j + 1])
                {
                    swap(arr[j], arr[j + 1]);
                }
            }
        }
    }
};

int main()
{
    ArraySort obj;

    obj.read();

    cout << "\nOriginal Array: ";
    obj.display();

    obj.sortArray();

    cout << "Sorted Array: ";
    obj.display();

    return 0;
}
