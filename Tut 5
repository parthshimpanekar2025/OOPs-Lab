#include <iostream>
using namespace std;

class Calculator {
public:
    
    int add(int a, int b) {
        return a + b;
    }

   
    int add(int a, int b, int c) {
        return a + b + c;
    }

   
    double add(double a, double b) {
        return a + b;
    }

   
    string add(string a, string b) {
        return a + b;
    }
};


void display(int num) {
    cout << "Integer value: " << num << endl;
}

void display(double num) {
    cout << "Double value: " << num << endl;
}

void display(char ch) {
    cout << "Character value: " << ch << endl;
}

void display(int num, int times) {
    cout << "Displaying " << num << " a total of " << times << " times: ";
    for (int i = 0; i < times; i++) {
        cout << num << " ";
    }
    cout << endl;
}

int main() {
    Calculator calc;

    cout << "----- Function Overloading with Class Methods -----\n";
    cout << "add(5, 10) = " << calc.add(5, 10) << endl;
    cout << "add(5, 10, 15) = " << calc.add(5, 10, 15) << endl;
    cout << "add(3.5, 2.7) = " << calc.add(3.5, 2.7) << endl;
    cout << "add(\"Hello, \", \"World!\") = " << calc.add(string("Hello, "), string("World!")) << endl;

    cout << "\n----- Function Overloading with Standalone Functions -----\n";
    display(100);
    display(45.67);
    display('A');
    display(7, 3);

    return 0;
}
